        },
        {
          "value": "metal",
          "label": "Metal"
        }
      ],
      "showIf": [
        {
          "source": [
            "primitive",
            "artwork"
          ]
        },
        {
          "source": "model",
          "materialMode": "pair"
        },
        {
          "source": "collection"
        }
      ]
