{
  "id": "3d-studio",
  "name": "3D Studio",
  "version": "0.3.0",
  "engineVersion": ">=1.204.0",
  "status": "official",
  "singleInstance": true,
  "category": "designer",
  "description": "Turn SVG artwork and 3D models into coordinated images. Shape materials, lighting, focus and transparent shadows with guided or expert controls.",
  "a11yLabel": "3D studio rendering with {{studio}} lighting",
  "tags": [
    "3d",
    "studio",
    "icons",
    "logo",
    "svg",
    "extrusion",
    "glb",
    "stl",
    "lighting",
    "materials",
    "product"
  ],
  "render": {
    "width": 1280,
    "height": 1280,
    "formats": [
      "png",
      "jpg",
      "webp",
      "avif",
      "tiff",
      "webm",
      "mp4",
      "gif"
    ],
    "actions": [
      "copy",
      "download",
      "save"
    ],
    "convertPaths": false,
    "video": {
      "wait": 1,
      "duration": 5
    },
    "sectionIcons": {
      "Start": "box",
      "Collection": "box",
      "Look": "paintbrush",
      "Shape": "layers",
      "Camera": "camera",
      "Depth": "camera",
      "Stage": "image",
      "Lighting": "box",
      "Materials": "paintbrush",
      "Output": "download",
      "Lights": "sunburst"
    }
  },
  "hooks": {
    "onInit": true,
    "onInput": true
  },
  "inputs": [
    {
      "id": "controls",
      "label": "Controls",
      "type": "select",
      "default": "guided",
      "section": "Start",
      "options": [
        {
          "value": "guided",
          "label": "Guided"
        },
        {
          "value": "expert",
          "label": "Expert"
        }
      ]
    },
    {
      "id": "source",
      "label": "Start with",
      "type": "select",
      "default": "primitive",
      "section": "Start",
      "options": [
        {
          "value": "primitive",
          "label": "A sample shape"
        },
        {
          "value": "artwork",
          "label": "SVG artwork"
        },
        {
          "value": "model",
          "label": "A 3D model"
        },
        {
          "value": "collection",
          "label": "A collection"
        }
      ]
    },
    {
      "id": "primitive",
      "label": "Shape",
      "type": "select",
      "default": "badge",
      "section": "Start",
      "options": [
        {
          "value": "badge",
          "label": "Two-colour badge"
        },
        {
          "value": "sphere",
          "label": "Sphere"
        },
        {
          "value": "box",
          "label": "Box"
        },
        {
          "value": "torus",
          "label": "Ring"
        }
      ],
      "showIf": {
        "source": "primitive"
      }
    },
    {
      "id": "artwork",
      "label": "Artwork",
      "type": "asset",
      "section": "Start",
      "assetType": "vector",
      "allowUpload": true,
      "showIf": {
        "source": "artwork"
      },
      "help": "Choose or upload an SVG icon or logo, up to 1 MB. Plain paths, shapes and solid fills are supported."
    },
    {
      "id": "modelAsset",
      "label": "Model",
      "type": "asset",
      "section": "Start",
      "assetType": "any",
      "allowUpload": true,
      "showIf": {
        "source": "model"
      },
      "help": "Choose or upload a self-contained GLB or STL up to 32 MB. Uploads are saved on this device for reuse."
    },
    {
      "id": "modelFormat",
      "label": "Model format",
      "type": "select",
      "default": "auto",
      "section": "Start",
      "options": [
        {
          "value": "auto",
          "label": "Detect from filename"
        },
        {
          "value": "glb",
          "label": "GLB"
        },
        {
          "value": "stl",
          "label": "STL"
        }
      ],
      "showIf": {
        "source": "model",
        "controls": "expert"
      }
    },
    {
      "id": "collectionName",
      "label": "Collection name",
      "type": "text",
      "default": "Studio collection",
      "section": "Collection",
      "showIf": {
        "source": "collection"
      }
    },
    {
      "id": "activeSubject",
      "label": "Preview item",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 24,
      "step": 1,
      "section": "Collection",
      "showIf": {
        "source": "collection"
      },
      "help": "Choose an item here or in Review collection. Shared controls apply to the whole set."
    },
    {
      "id": "subjects",
      "label": "Collection items",
      "type": "blocks",
      "section": "Collection",
      "showIf": {
        "source": "collection"
      },
      "labelledFields": true,
      "rowActions": true,
      "help": "Up to 24 items. All use this studio; each can keep its own framing and material slots.",
      "default": [
        {
          "name": "Badge",
          "kind": "primitive",
          "primitive": "badge"
        },
        {
          "name": "Sphere",
          "kind": "primitive",
          "primitive": "sphere"
        },
        {
          "name": "Box",
          "kind": "primitive",
          "primitive": "box"
        }
      ],
      "fields": [
        {
          "id": "name",
          "label": "Name",
          "type": "text",
          "default": "Item"
        },
        {
          "id": "kind",
          "label": "Source",
          "type": "select",
          "default": "artwork",
          "options": [
            {
              "value": "artwork",
              "label": "SVG artwork",
              "repeatable": true
            },
            {
              "value": "model",
              "label": "3D model",
              "repeatable": true
            },
            {
              "value": "primitive",
              "label": "Sample shape",
              "repeatable": true
            }
          ]
        },
        {
          "id": "asset",
          "label": "Artwork or model",
          "type": "asset",
          "assetType": "any",
          "allowUpload": true,
          "showFor": [
            "artwork",
            "model"
          ]
        },
        {
          "id": "primitive",
          "label": "Sample shape",
          "type": "select",
          "default": "badge",
          "options": [
            {
              "value": "badge",
              "label": "Two-colour badge"
            },
            {
              "value": "sphere",
              "label": "Sphere"
            },
            {
              "value": "box",
              "label": "Box"
            },
            {
              "value": "torus",
              "label": "Ring"
            }
          ],
          "showIf": {
            "kind": "primitive"
          }
        },
        {
          "id": "modelFormat",
          "label": "Model format",
          "type": "select",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Detect from filename"
            },
            {
              "value": "glb",
              "label": "GLB"
            },
            {
              "value": "stl",
              "label": "STL"
            }
          ],
          "showIf": {
            "kind": "model",
            "controls": "expert"
          }
        },
        {
          "id": "ownFraming",
          "label": "Use this item's framing",
          "type": "boolean",
          "default": false,
          "help": "Drag the selected preview to create a framing override. Turn this off to follow the shared camera again."
        },
        {
          "id": "azimuth",
          "label": "Azimuth",
          "type": "number",
          "default": 25,
          "min": -180,
          "max": 180,
          "step": 1,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "elevation",
          "label": "Elevation",
          "type": "number",
          "default": 14,
          "min": -60,
          "max": 80,
          "step": 1,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "fov",
          "label": "Field of view",
          "type": "number",
          "default": 29,
          "min": 15,
          "max": 80,
          "step": 1,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "zoom",
          "label": "Zoom",
          "type": "number",
          "default": 1,
          "min": 0.05,
          "max": 3,
          "step": 0.05,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "roleA",
          "label": "Material A slot",
          "type": "text",
          "default": "",
          "showIf": {
            "materialMode": "pair",
            "controls": "expert"
          },
          "help": "Exact slot name or number. Leave both empty for alternating finishes; mapped pairs leave other slots intact."
        },
        {
          "id": "roleB",
          "label": "Material B slot",
          "type": "text",
          "default": "",
          "showIf": {
            "materialMode": "pair",
            "controls": "expert"
          },
          "help": "Exact slot name or number. Leave both empty for alternating finishes; mapped pairs leave other slots intact."
        },
        {
          "id": "panX",
          "label": "Target offset X",
          "type": "number",
          "default": 0,
          "min": -20,
          "max": 20,
          "step": 0.05,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "panY",
          "label": "Target offset Y",
          "type": "number",
          "default": 0,
          "min": -20,
          "max": 20,
          "step": 0.05,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "panZ",
          "label": "Target offset Z",
          "type": "number",
          "default": 0,
          "min": -20,
          "max": 20,
          "step": 0.05,
          "showIf": {
            "ownFraming": true
          }
        },
        {
          "id": "ownFocus",
          "label": "Own focus distance",
          "type": "boolean",
          "default": false
        },
        {
          "id": "focusDistance",
          "label": "Focus distance (0 = automatic)",
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 500,
          "step": 0.1,
          "showIf": {
            "ownFocus": true
          }
        }
      ],
      "addMenu": {
        "field": "kind",
        "label": "Add item"
      }
    },
    {
      "id": "studio",
      "label": "Lighting studio",
      "type": "select",
      "default": "dramatic",
      "section": "Look",
      "options": [
        {
          "value": "soft",
          "label": "Soft studio"
        },
        {
          "value": "dramatic",
          "label": "Dramatic edge"
        },
        {
          "value": "electric",
          "label": "Cool contrast"
        },
        {
          "value": "warm",
          "label": "Warm edge"
        },
        {
          "value": "custom",
          "label": "Custom lights",
          "showIf": {
            "controls": "expert"
          }
        }
      ]
    },
    {
      "id": "materialMode",
      "label": "Materials",
      "type": "select",
      "default": "source",
      "section": "Look",
      "options": [
        {
          "value": "source",
          "label": "Keep source materials"
        },
        {
          "value": "pair",
          "label": "Apply a colour pair"
        },
        {
          "value": "custom",
          "label": "Override selected slots",
          "showIf": {
            "controls": "expert"
          }
        }
      ]
    },
    {
      "id": "colorA",
      "label": "Colour A",
      "type": "color",
