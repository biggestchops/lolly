      "label": "Light motion",
      "type": "select",
      "default": "still",
      "section": "Look",
      "options": [
        {
          "value": "still",
          "label": "Stationary"
        },
        {
          "value": "orbit",
          "label": "Orbit the studio"
        },
        {
          "value": "breathe",
          "label": "Gently breathe"
        }
      ],
      "help": "Uses Loop seconds. Moving lights change illumination, reflections and cast shadows."
    },
    {
      "id": "lightMotionAmount",
      "label": "Light motion amount",
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "section": "Look",
      "showIf": {
        "lightMotion": [
          "orbit",
          "breathe"
        ]
      },
      "help": "Orbit sweeps out and back; breathing gently varies light strength."
    },
